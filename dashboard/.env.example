# API backend URL (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL (default: ws://localhost:8000/ws/stream)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream

# External public status page, hosted outside SolProbe (for example incident.io custom domain)
NEXT_PUBLIC_STATUS_PAGE_URL=https://status.example.com
