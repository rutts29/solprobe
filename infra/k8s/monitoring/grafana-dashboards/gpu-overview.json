{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "GPU Temperature per Node",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "gpu_temperature_celsius{node_id=~\"$node_id\"}",
          "legendFormat": "{{ node_id }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      }
    },
    {
      "title": "GPU Utilization per Node",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "gpu_utilization_percent{node_id=~\"$node_id\"}",
          "legendFormat": "{{ node_id }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "title": "GPU Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "gpu_memory_used_bytes{node_id=~\"$node_id\"}",
          "legendFormat": "{{ node_id }} used",
          "refId": "A"
        },
        {
          "expr": "gpu_memory_total_bytes{node_id=~\"$node_id\"}",
          "legendFormat": "{{ node_id }} total",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "title": "GPU Power Draw",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "gpu_power_usage_watts{node_id=~\"$node_id\"}",
          "legendFormat": "{{ node_id }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["solprobe", "gpu"],
  "templating": {
    "list": [
      {
        "name": "node_id",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(gpu_temperature_celsius, node_id)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "SolProbe GPU Overview",
  "uid": "solprobe-gpu-overview"
}
