{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Training Loss Curve",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "training_loss{node_id=~\"$node_id\"}",
          "legendFormat": "{{ node_id }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" } }
    },
    {
      "title": "Gradient Norm",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "training_grad_norm{node_id=~\"$node_id\"}",
          "legendFormat": "{{ node_id }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" } }
    },
    {
      "title": "Training Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "training_throughput_samples_per_sec{node_id=~\"$node_id\"}",
          "legendFormat": "{{ node_id }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Model FLOPs Utilization (MFU %)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "training_mfu_percent{node_id=~\"$node_id\"}",
          "legendFormat": "{{ node_id }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "title": "Connected Nodes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "solprobe_connected_nodes",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Total Alerts",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "targets": [
        {
          "expr": "solprobe_total_alerts",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Total Diagnoses",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "solprobe_total_diagnoses",
          "refId": "A"
        }
      ]
    },
    {
      "title": "WebSocket Clients",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "targets": [
        {
          "expr": "solprobe_ws_clients",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["solprobe", "training"],
  "templating": {
    "list": [
      {
        "name": "node_id",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(training_loss, node_id)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "SolProbe Training Health",
  "uid": "solprobe-training-health"
}
